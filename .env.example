PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (TypeORM usa esta URL)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samts_db

# Poner en true solo si tu proveedor de base de datos exige SSL (ej. producción)
DB_SSL=false

# Clave para firmar los JWT — CAMBIAR en producción por un valor secreto y largo
JWT_SECRET=super-secret-key-change-in-production

# ─── Proveedor de Correos Transaccionales (Resend) ──────────────────────────
# Valores admitidos para EMAIL_PROVIDER: 'mock' (predeterminado en dev/test) | 'resend'
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="SAMTS <contacto@samts.app>"

# ─── Integración S2S con SAMTS Catalog (invitaciones de lanzamiento) ────────
# Base URL del backend de SAMTS Catalog (ej. https://api.samts.app o http://localhost:3000).
# Sin esta variable el cliente S2S de invitaciones lanza ServiceUnavailableException.
SAMTS_CATALOG_API_URL=
# Secreto compartido servicio-a-servicio. Se envía como cabecera X-Service-Key.
# NUNCA se registra en logs ni se expone por API. Si no está configurado, el
# callback S2S se rechaza en producción.
SAMTS_CATALOG_SERVICE_KEY=
