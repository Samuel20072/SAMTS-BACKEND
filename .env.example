PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (TypeORM usa esta URL)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samts_db

# Poner en true solo si tu proveedor de base de datos exige SSL (ej. producción)
DB_SSL=false

# Clave para firmar los JWT — CAMBIAR en producción por un valor secreto y largo
JWT_SECRET=super-secret-key-change-in-production

# ─── Proveedor de Correos Transaccionales (Resend) ──────────────────────────
# Valores admitidos para EMAIL_PROVIDER: 'mock' (predeterminado en dev/test) | 'resend'
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="SAMTS <contacto@samts.app>"
